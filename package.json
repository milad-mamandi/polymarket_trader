{
  "name": "polymarket-whale-scout",
  "version": "2.0.0",
  "description": "A dashboard to track whales and suspicious wallets on Polymarket with paper trading",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "npm run clean && tsc && npm run build:client",
    "build:client": "cd src/web/client && npm run build",
    "start": "node dist/main.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "polymarket",
    "whale",
    "trading",
    "prediction-markets"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "telegraf": "^4.15.6",
    "winston": "^3.11.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.5",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
