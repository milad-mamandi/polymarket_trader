{
  "name": "polymarket-whale-scout",
  "version": "2.0.0",
  "description": "A dashboard to track whales and suspicious wallets on Polymarket with paper trading",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "npm run clean && tsc && npm run build:client",
    "build:client": "cd src/web/client && npm run build",
    "start": "node dist/main.js",
    "clean": "rm -rf dist",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/integration",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/e2e",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch"
  },
  "keywords": [
    "polymarket",
    "whale",
    "trading",
    "prediction-markets"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@polymarket/clob-client": "^5.2.1",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "ethers": "^5.7.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "telegraf": "^4.16.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.30",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
