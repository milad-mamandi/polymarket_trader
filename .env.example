# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Configuration
WHALE_THRESHOLD_USD=50000
NEW_WALLET_HOURS=24
MIN_CONFIDENCE_FOR_TRADE=70
INITIAL_PAPER_BALANCE=10000
MAX_POSITION_SIZE_PERCENT=10

# Real Trading Mode (default: paper)
TRADING_MODE=paper
REAL_TRADING_PRIVATE_KEY=
REAL_TRADING_FUNDER_ADDRESS=
REAL_TRADING_SIGNATURE_TYPE=0
REAL_TRADING_CHAIN_ID=137
REAL_TRADING_MAX_POSITION_USD=1000
REAL_TRADING_DAILY_LIMIT_USD=5000
REAL_TRADING_START_HOUR=0
REAL_TRADING_END_HOUR=23
REAL_TRADING_KILL_SWITCH_ENABLED=false

# Polling Intervals (milliseconds)
TRADE_POLL_INTERVAL_MS=30000
RESOLUTION_CHECK_INTERVAL_MS=300000

# Logging
LOG_LEVEL=info

# Error Handling
ERROR_LOG_LEVEL_422=warn
MARKET_AGE_THRESHOLD_DAYS=7
MARK_OLD_AS_ARCHIVED=true

# Web Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000

# Dashboard password - can be plain text OR bcrypt hash (recommended)
# Plain text example: admin123
# To generate a bcrypt hash, run: node dist/cli/index.js password hash YourPassword
# Hashed passwords start with $2a$, $2b$, or $2y$
# For production, always use hashed passwords!
DASHBOARD_PASSWORD=admin123

DASHBOARD_SESSION_SECRET=change-this-to-random-secret-in-production
