[Unit]
Description=Cloudflare Tunnel for Whale Scout Dashboard
After=network.target whale-scout.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/cloudflared tunnel run whale-scout
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
